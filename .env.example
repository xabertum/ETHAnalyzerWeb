# Puerto del backend dentro del contenedor
PORT=4000

# Ruta del fichero SQLite (en Docker apunta al volumen persistente)
DB_PATH=/data/eth.db

# API pública de CoinGecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_COIN_ID=ethereum
BASE_CURRENCY=eur

# Caché de precios (ms)
PRICE_CACHE_TTL_MS=30000
HISTORY_CACHE_TTL_MS=300000

# Intervalo del poller de alertas (ms)
ALERT_POLL_INTERVAL_MS=60000

# Puertos publicados por docker compose
BACKEND_PORT=4000
FRONTEND_PORT=8080
